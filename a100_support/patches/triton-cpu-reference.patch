     Location loc = op.getLoc();
     Value i32Src = op_bitcast(toInt32(src.getType()), src);
+    // arith.truncf defaults to nearest-even; dropping the low bits is RTZ.
+    // Preserve NaNs (including tiny payloads) instead of rounding them to inf.
+    auto mode = op.getRoundingmode();
+    if (mode && *mode != arith::RoundingMode::to_nearest_even &&
+        *mode != arith::RoundingMode::toward_zero)
+      return failure();
+    if (!mode || *mode == arith::RoundingMode::to_nearest_even) {
+      Value odd = op_and(op_lshr(i32Src, cst_like(i32Src, 16)), cst_like(i32Src, 1));
+      Value rounded = op_addi(i32Src, op_addi(cst_like(i32Src, 0x7fff), odd));
+      Value isNan = op_icmp_ugt(op_and(i32Src, cst_like(i32Src, 0x7fffffff)),
+                               cst_like(i32Src, 0x7f800000));
+      i32Src = op_select(isNan, op_or(i32Src, cst_like(i32Src, 0x00400000)), rounded);
+    }
