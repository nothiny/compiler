+struct GatherOpConversion : public OpConversionPattern<triton::GatherOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+  LogicalResult matchAndRewrite(triton::GatherOp op, OpAdaptor adaptor,
+                               ConversionPatternRewriter &rewriter) const override {
+    auto loc = op.getLoc();
+    Value src = rewriter.getRemappedValue(op.getSrc());
+    Value indices = rewriter.getRemappedValue(op.getIndices());
+    auto resultTy = cast<VectorType>(getTypeConverter()->convertType(op.getType()));
+    auto shape = resultTy.getShape();
+    auto strides = computeStrides(shape);
+    Value result = arith::ConstantOp::create(rewriter, loc, rewriter.getZeroAttr(resultTy));
+    for (int64_t i = 0; i < resultTy.getNumElements(); ++i) {
+      auto coordinates = delinearize(i, strides);
+      Value index = vector::ExtractOp::create(rewriter, loc, indices, coordinates);
+      index = arith::IndexCastOp::create(rewriter, loc, rewriter.getIndexType(), index);
+      SmallVector<OpFoldResult> positions;
+      for (int64_t axis = 0; axis < (int64_t)shape.size(); ++axis)
+        if (axis == op.getAxis()) positions.push_back(index);
+        else positions.push_back(rewriter.getIndexAttr(coordinates[axis]));
+      Value element = vector::ExtractOp::create(rewriter, loc, src, positions);
+      result = vector::InsertOp::create(rewriter, loc, element, result, coordinates);
+    }
+    rewriter.replaceOp(op, result);
+    return success();
+  }
+};
